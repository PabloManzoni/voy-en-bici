# Copiá este archivo a `.env.local`.
# URL del servidor de IA (carpeta `tuggsy-ia`). Es pública, NO es un secreto.
# Sin esta variable la app funciona igual: usa explicaciones de plantilla en vez de IA.
#
# REGLA: en este archivo nunca va una API key. Todo lo que empieza con VITE_
# termina dentro del JS que baja cualquier visitante.
#
# Producción:  VITE_IA_URL=https://ia.tuggsy.com
# Local (con `npm --prefix tuggsy-ia run dev` corriendo):
VITE_IA_URL=http://localhost:8787
